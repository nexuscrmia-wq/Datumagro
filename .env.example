# Example environment variables for DatumAgro
# Copy to `.env` and fill values for local/staging/production

# Django
SECRET_KEY=replace-with-generated-secret
DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (use a production-ready DB in prod)
DATABASE_URL=postgres://user:password@localhost:5432/datumagro

# Redis (for cache and Celery)
REDIS_URL=redis://127.0.0.1:6379/0

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Frontend (used in password reset links)
FRONTEND_URL=http://localhost:3000

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_PII=False

# Production-specific
ENVIRONMENT=production
# ============================================================================
# DatumAgro - Environment Variables for Render.com Production
# ============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# ============================================================================
# Django Core Settings
# ============================================================================
# Set to 'production' for production deployment
ENVIRONMENT=production

# Django Debug Mode (NEVER use True in production)
DEBUG=False

# IMPORTANT: Generate a new SECRET_KEY for production!
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-this-in-render

# Allowed hosts for Django (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# ============================================================================
# DATABASE (Render PostgreSQL)
# ============================================================================
# On Render, DATABASE_URL is automatically created when you add PostgreSQL
# Format: postgresql://user:password@host:port/dbname
# You can leave this blank and Render will set it automatically
DATABASE_URL=postgresql://user:password@localhost:5432/datumagro

# ============================================================================
# REDIS (Cache & Sessions)
# ============================================================================
# For production, use Render Redis or external Redis service
REDIS_URL=redis://127.0.0.1:6379/1

# ============================================================================
# FRONTEND URLs
# ============================================================================
RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com
FRONTEND_URL=https://your-frontend.onrender.com

# ============================================================================
# EMAIL Configuration (SMTP)
# ============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app-especifica-gmail

# ============================================================================
# Twilio (Optional - for WhatsApp notifications)
# ============================================================================
TWILIO_ACCOUNT_SID=seu-twilio-sid
TWILIO_AUTH_TOKEN=seu-twilio-token
TWILIO_WHATSAPP_NUMBER=+5588999999999

# ============================================================================
# CORS Configuration (for Flutter app)
# ============================================================================
CORS_ALLOWED_ORIGINS=https://your-app.onrender.com,https://flutter-app.example.com

# ============================================================================
# Security Settings (Production)
# ============================================================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# ============================================================================
# Database Configuration
# ============================================================================
# Development: SQLite (default)
# Production: PostgreSQL recommended
# DATABASE_URL=sqlite:///./db.sqlite3

# PostgreSQL Example (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/datumagro

# ============================================================================
# Email Configuration (for user registration, password reset, notifications)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# Frontend Configuration
# ============================================================================
FRONTEND_URL=http://localhost:3000

# ============================================================================
# Twilio Configuration (Optional - for SMS/WhatsApp notifications)
# ============================================================================
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+551234567890

# ============================================================================
# Production Settings
# ============================================================================
# Render.com deployment hostname (auto-configured)
RENDER_EXTERNAL_HOSTNAME=your-app-name.onrender.com

# ============================================================================
# CORS Configuration (Production)
# ============================================================================
# Set the Flutter app URL in production
CORS_ALLOWED_ORIGINS=https://your-app-name.onrender.com

# ============================================================================
# Security Settings (Production)
# ============================================================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
